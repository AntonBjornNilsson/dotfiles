# Display time
SPACESHIP_TIME_SHOW=false

# Display username always
SPACESHIP_USER_SHOW=always

# Do not truncate path in repos
SPACESHIP_DIR_TRUNC_REPO=false

# Add custom Ember section
# See: https://github.com/spaceship-prompt/spaceship-ember
spaceship add dir
spaceship add docker
spaceship add exit_code
# spaceship add git
spaceship add git_branch
spaceship add git_commit
spaceship add git_status
spaceship add kubectl
spaceship add kubectl_context
spaceship add venv
